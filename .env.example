# Copie este arquivo para .env e preencha com os dados do seu projeto Supabase.
# Use somente uma chave Publishable (sb_publishable_); nunca use uma chave Secret
# (sb_secret_) em variáveis VITE_, pois elas são incluídas no código do navegador.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sua-chave-publishable
